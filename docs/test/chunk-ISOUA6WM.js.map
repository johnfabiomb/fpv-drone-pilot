{
  "name": "venture-map",
  "version": "2.0.16",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prebuild": "node scripts/convert-to-webp.js && node scripts/generate-sitemap.js",
    "build": "ng build",
    "deploy": "node scripts/bump-version.js && ng build --configuration production && npm run staging",
    "staging": "ng build --configuration staging",
    "preview": "ng build --configuration production && npx http-server docs -p 4200 -c-1",
    "preview:staging": "ng build --configuration staging && npx http-server docs -p 4201 -c-1 --open /test/",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.2.1",
    "@angular/cdk": "^19.2.1",
    "@angular/common": "^19.2.1",
    "@angular/compiler": "^19.2.1",
    "@angular/core": "^19.2.1",
    "@angular/forms": "^19.2.1",
    "@angular/material": "^19.2.1",
    "@angular/platform-browser": "^19.2.1",
    "@angular/platform-browser-dynamic": "^19.2.1",
    "@angular/platform-server": "^19.2.21",
    "@angular/router": "^19.2.1",
    "@angular/service-worker": "^19.2.21",
    "@angular/ssr": "^19.2.25",
    "@nguniversal/express-engine": "^7.0.2",
    "@stripe/stripe-js": "^9.4.0",
    "@supabase/supabase-js": "^2.106.2",
    "emoji-picker-element": "^1.29.1",
    "ol": "^9.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.1",
    "@angular/cli": "^19.2.1",
    "@angular/compiler-cli": "^19.2.1",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "sharp": "^0.34.5",
    "typescript": "~5.8.2"
  }
}
