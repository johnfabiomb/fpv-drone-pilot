{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "venture-map": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "baseHref": "/",
            "outputPath": {
              "base": "docs",
              "browser": ""
            },
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "src/favicon.ico",
              "src/assets",
              {
                "glob": "sw.js",
                "input": "src",
                "output": "/"
              },
              {
                "glob": "robots.txt",
                "input": "src",
                "output": "/"
              },
              {
                "glob": "ads.txt",
                "input": "src",
                "output": "/"
              },
              {
                "glob": "sitemap.xml",
                "input": "src",
                "output": "/"
              },
              {
                "glob": "site.webmanifest",
                "input": "src",
                "output": "/"
              },
              {
                "glob": "*.png",
                "input": "src",
                "output": "/"
              },
              {
                "glob": "CNAME",
                "input": "src",
                "output": "/"
              },
              {
                "glob": "googlead59dfa09fcacaec.html",
                "input": "src",
                "output": "/"
              },
              {
                "glob": "404.html",
                "input": "src",
                "output": "/"
              }
            ],
            "styles": [
              "src/styles.scss",
              "node_modules/ol/ol.css"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "src/app/map/feature-flags.ts",
                  "with": "src/environments/feature-flags.production.ts"
                },
                {
                  "replace": "src/app/map/core/config/supabase.config.ts",
                  "with": "src/environments/supabase.config.production.ts"
                },
                {
                  "replace": "src/app/booking/core/db/supabase.bookings.ts",
                  "with": "src/environments/supabase.bookings.production.ts"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kb",
                  "maximumError": "1mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "16kb",
                  "maximumError": "24kb"
                }
              ],
              "outputHashing": "all",
              "server": "src/server.ts",
              "prerender": {
                "discoverRoutes": false,
                "routesFile": "prerender-routes.txt"
              },
              "ssr": false
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "staging": {
              "fileReplacements": [
                {
                  "replace": "src/app/map/feature-flags.ts",
                  "with": "src/environments/feature-flags.staging.ts"
                }
              ],
              "outputPath": {
                "base": "docs/test",
                "browser": ""
              },
              "baseHref": "/test/",
              "index": { "input": "src/index.staging.html", "output": "index.html" },
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "server": "src/server.ts",
              "prerender": {
                "discoverRoutes": false,
                "routesFile": "prerender-routes.txt"
              },
              "ssr": false
            },
          },
          "defaultConfiguration": "staging"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "venture-map:build:production"
            },
            "development": {
              "buildTarget": "venture-map:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "venture-map:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "src/favicon.ico",
              "src/assets"
            ],
            "styles": [
              "src/styles.scss"
            ],
            "scripts": []
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}